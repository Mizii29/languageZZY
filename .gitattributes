# Preserve literal BOM/CRLF test inputs on every checkout.
# Keep application source hashes/line reports reproducible on Windows and POSIX.
apps/zzy-campus/*.zzy text eol=lf
tests/lex/inputs/bom-crlf.zzy -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
tests/lex/inputs/comments-crlf.zzy -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
tests/lex/inputs/physical-crlf.zzy -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
tests/check/inputs/bom-crlf.zzy -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
tests/check/inputs/bom-crlf-name.zzy -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol

# Measured byte snapshots and raw evidence must survive checkout unchanged.
benchmarks/results/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
# pstats emits a terminating blank line; preserve its verbatim report.
benchmarks/results/**/profile.txt whitespace=blank-at-eol,space-before-tab,cr-at-eol,-blank-at-eof
