(use) "model.zzy" (as) model;

zzysay: Decode DEL once using standard JSON, without inventing a ZZY escape.
(zyes) delete_char := "";
(?_?) data.parse("[OoO]q\u007f[OoO]q") {
    (^_^)(value) => { delete_char <- value; }
    (T_T)(message) => { (o_o) (false); }
}
(addnew) integer(value, minimum: (Int), maximum: (Int), path: (String)) -> (Result) {
    (zif?:) data.kind(value) != "int" { (return) (T_T)(path + ": 需要整数"); }
    (zif?:) value < minimum (or) value > maximum { (return) (T_T)(path + ": 超出范围"); }
    (return) (^_^)(value);
}
(addnew) label(value, maximum: (Int), path: (String)) -> (Result) {
    (zif?:) data.kind(value) != "string" { (return) (T_T)(path + ": 需要字符串"); }
    (zif?:) len(value) < 1 (or) len(value) > maximum { (return) (T_T)(path + ": 长度超出范围"); }
    (zif?:) len(text.trim(value)) == 0 { (return) (T_T)(path + ": 不能全为空白"); }
    (for) character (in) value {
        (zif?:) character < " " (or) character == delete_char {
            (return) (T_T)(path + ": 不允许控制字符");
        }
    }
    (return) (^_^)(value);
}
(addnew) task_fields(id, title, category, priority, done, path: (String)) -> (Result) {
    integer(id, 1, 2147483647, path + ".id")?;
    label(title, 200, path + ".title")?;
    label(category, 40, path + ".category")?;
    integer(priority, 1, 3, path + ".priority")?;
    (zif?:) data.kind(done) != "bool" { (return) (T_T)(path + ".done: 需要布尔值"); }
    (return) (^_^)(model.Task::{id: id, title: title, category: category, priority: priority, done: done});
}
(addnew) keys(value, required: (Array), path: (String)) -> (Result) {
    (zif?:) data.kind(value) != "map" { (return) (T_T)(path + ": 需要对象"); }
    (for) key (in) required {
        (zif?:) (not) data.has(value, key) { (return) (T_T)(path + "." + key + ": 缺少字段"); }
    }
    (zif?:) len(data.keys(value)) != len(required) { (return) (T_T)(path + ": 含未知字段"); }
    (return) (^_^)(value);
}
(addnew) document(root) -> (Result) {
    keys(root, ["schema_version", "next_id", "tasks"], "root")?;
    integer(data.get(root, "schema_version"), 1, 1, "schema_version")?;
    (zno) next_id := integer(data.get(root, "next_id"), 1, 2147483648, "next_id")?;
    (zno) source := data.get(root, "tasks");
    (zif?:) data.kind(source) != "array" { (return) (T_T)("tasks: 需要数组"); }
    (zif?:) len(source) > 10000 { (return) (T_T)("tasks: 最多10000项"); }
    (zno) seen := data.map();
    (zno) result := [];
    (zyes) maximum := 0;
    (zyes) index := 0;
    (for) item (in) source {
        (zno) path := "tasks[" + str(index) + "]";
        keys(item, ["id", "title", "category", "priority", "done"], path)?;
        (zno) task := task_fields(data.get(item, "id"), data.get(item, "title"),
            data.get(item, "category"), data.get(item, "priority"), data.get(item, "done"), path)?;
        (zno) key := str(task.id);
        (zif?:) data.has(seen, key) { (return) (T_T)(path + ".id: 重复ID"); }
        data.set(seen, key, (true));
        (zif?:) task.id > maximum { maximum <- task.id; }
        array.push(result, task);
        index <- index + 1;
    }
    (zif?:) next_id <= maximum { (return) (T_T)("next_id: 必须大于所有ID"); }
    (return) (^_^)(model.Document::{next_id: next_id, tasks: result});
}
zzysay: Internal Documents contain Task values; still validate every save field.
(addnew) current(doc: model.Document) -> (Result) {
    integer(doc.next_id, 1, 2147483648, "next_id")?;
    (zif?:) len(doc.tasks) > 10000 { (return) (T_T)("tasks: 最多10000项"); }
    (zno) seen := data.map();
    (zyes) index := 0;
    (for) item (in) doc.tasks {
        (zno) path := "tasks[" + str(index) + "]";
        task_fields(item.id, item.title, item.category, item.priority, item.done, path)?;
        (zif?:) item.id >= doc.next_id { (return) (T_T)("next_id: 必须大于所有ID"); }
        (zno) key := str(item.id);
        (zif?:) data.has(seen, key) { (return) (T_T)(path + ".id: 重复ID"); }
        data.set(seen, key, (true));
        index <- index + 1;
    }
    (return) (^_^)(doc);
}
