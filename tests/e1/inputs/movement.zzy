(zno)c:sketch.Canvas:=sketch.canvas(200,100,"画布");
(zno)p:sketch.Pen:=sketch.pen(c,"笔");
sketch.forward(p,10);sketch.backward(p,-5);sketch.left(p,-450);sketch.right(p,-90);sketch.forward(p,-3);io.print(sketch.position(p));io.print(sketch.heading(p));sketch.home(p);io.print(sketch.position(p));io.print(sketch.heading(p));
