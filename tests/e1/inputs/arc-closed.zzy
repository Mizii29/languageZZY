(zno)c:sketch.Canvas:=sketch.canvas(200,100,"画布");
(zno)p:sketch.Pen:=sketch.pen(c,"笔");
sketch.jump_to(p,7,9);sketch.set_heading(p,37);(for)i(in)range(0,50,1){sketch.circle(p,-3,720);}io.print(sketch.position(p));io.print(sketch.heading(p));sketch.circle(p,10,0);sketch.polyline(p,[]);io.print(sketch.position(p));
