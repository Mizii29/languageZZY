execute_process(COMMAND "${EXE}" "${MODE}" RESULT_VARIABLE result
  OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 5)
if(NOT result STREQUAL "${EXPECTED}")
  message(FATAL_ERROR "probe ${MODE} expected ${EXPECTED}, got ${result}: ${error}")
endif()
string(JSON objects GET "${output}" objects)
string(JSON slots GET "${output}" slots)
string(JSON payload GET "${output}" payload)
if(NOT objects EQUAL 0 OR NOT slots EQUAL 0 OR NOT payload EQUAL 0)
  message(FATAL_ERROR "cleanup counters not zero")
endif()
if(MODE STREQUAL "success")
  if(NOT error STREQUAL "")
    message(FATAL_ERROR "successful probe emitted error")
  endif()
else()
  string(JSON kind GET "${error}" kind)
  if(MODE STREQUAL "cancel" AND NOT kind STREQUAL "cancelled")
    message(FATAL_ERROR "incorrect cancellation diagnostic")
  elseif(MODE STREQUAL "resource")
    string(JSON code GET "${error}" code)
    if(NOT code STREQUAL "E211")
      message(FATAL_ERROR "incorrect resource diagnostic")
    endif()
  elseif(MODE STREQUAL "error" AND NOT kind STREQUAL "internal_error")
    message(FATAL_ERROR "incorrect internal error diagnostic")
  endif()
endif()
