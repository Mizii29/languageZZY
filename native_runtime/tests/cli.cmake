execute_process(COMMAND "${EXE}" "${MODE}" --diagnostic-format json
  RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 5)
if(MODE STREQUAL "info")
  if(NOT result STREQUAL "0" OR NOT error STREQUAL "")
    message(FATAL_ERROR "info failed: ${result}: ${error}")
  endif()
  string(JSON stage GET "${output}" stage)
  string(JSON fallback GET "${output}" python_fallback)
  string(JSON count LENGTH "${output}" supported_commands)
  string(JSON sqlite GET "${output}" sqlite_enabled)
  string(JSON test_enabled GET "${output}" test_enabled)
  if(NOT stage STREQUAL "N5" OR fallback OR NOT count EQUAL 7 OR NOT test_enabled OR (SQLITE AND NOT sqlite) OR (NOT SQLITE AND sqlite))
    message(FATAL_ERROR "Incorrect capability record")
  endif()
else()
  if(NOT result STREQUAL "2" OR NOT output STREQUAL "")
    message(FATAL_ERROR "test command exit protocol mismatch")
  endif()
  string(JSON code GET "${error}" code)
  if(NOT code STREQUAL "E401")
    message(FATAL_ERROR "test arguments protocol mismatch")
  endif()
endif()
